# Local P0 runner only. Never use a Vercel/stateless filesystem as authoritative private state.
PHLOEM_PRIVATE_STATE_PATH=.phloem/private-state.v1.enc
# Server-only 32-byte AES key encoded as 64 lowercase hexadecimal characters.
PHLOEM_PRIVATE_STATE_KEY_HEX=

# Server-side only. Supply the value in apps/web/.env.local when live NIM testing begins.
NVIDIA_API_KEY=

# Server-only Ed25519 seed for the controlled Research Data Service.
# Supply this in apps/web/.env.local before live provider signing; never expose it as NEXT_PUBLIC_*.
PROVIDER_SIGNING_SECRET=
# Separate server-only SPP custody keys for the controlled provider. The note key is a
# canonical non-zero BN254 field encoded as 32-byte little-endian hex; the encryption
# key is a raw 32-byte X25519 private key. Never reuse PROVIDER_SIGNING_SECRET here.
PROVIDER_SPP_NOTE_PRIVATE_KEY_LE_HEX=
PROVIDER_SPP_ENCRYPTION_PRIVATE_KEY_HEX=
PROVIDER_FIXED_PRICE_ATOMIC=100000
