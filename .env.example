# Public network configuration only. Never put secret keys in this file.
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev
ANCHOR_BASE_URL=https://tr-mock-anchor.fly.dev

# Populated after wallet connection/discovery/deployment.
COMPANY_FUNDING_PUBLIC_KEY=
USDC_ASSET_CODE=
USDC_ISSUER=
TREASURY_CONTROLLER_ID=
SPP_POOL_ID=
SPP_REGISTRY_ID=
BUDGET_VERIFIER_ID=
BINDING_VERIFIER_ID=
AUDIT_VERIFIER_ID=

# Local encrypted state path. The encryption key is supplied separately at runtime.
PHLOEM_PRIVATE_STATE_PATH=.phloem/private-state.v1.enc
