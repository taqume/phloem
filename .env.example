# Public network configuration only. Never put secret keys in this file.
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev
ANCHOR_BASE_URL=https://tr-mock-anchor.fly.dev
# Server-only key used to encrypt the short-lived SEP-10 Anchor session cookie.
# Set a random value of at least 32 characters in apps/web/.env.local before live authentication.
ANCHOR_SESSION_SECRET=

# Public Testnet deployment configuration. Audit verifier remains deferred until AuditQL.
COMPANY_FUNDING_PUBLIC_KEY=
USDC_ASSET_CODE=USDC
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
TREASURY_CONTROLLER_ID=CBQJEY3J4DDJ4OUGSGHUVLRI2NYOS2XVRZ5V7ACWYPFDGB2IJLSMAS67
SPP_POOL_ID=CC57FDSWPIHALXW2XWVSKEA7FA72Z37Y7AP5ASRY6V3CXAZCWQAOSLB4
SPP_REGISTRY_ID=CB3OX6UGZCKQZFN3WQHCIBBAMIWIDHLZWC4JS6VYJE4U5WWQN5GFELKT
ED25519_VERIFIER_ID=CC3HSAEYBR5EHKVFQ2QUYZ3HWFIDDPNEQ2JT5EB2ZXWS3M34ITJ25NRR
BUDGET_VERIFIER_ID=CD3GQVHD4R3E4WMFEFB6H5IJJUZXYE3IFFNY65P2J3L2V6R6A6FTJQ4O
ROOT_BACKING_VERIFIER_ID=CBR7ZUMSLGWHUJBL7YKL2HRTYAWB34CPM5MG5OFYANENMOTCBHH3A5PA
