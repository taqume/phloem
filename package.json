{
  "name": "phloem",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded economic authority for autonomous agents on Stellar",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "contracts:build": "scripts/contracts/build.sh",
    "contracts:bindings:generate": "scripts/contracts/check-bindings.sh --write",
    "contracts:bindings:check": "scripts/contracts/check-bindings.sh",
    "contracts:test": "rustup run 1.95.0 cargo test --workspace",
    "vectors:generate": "pnpm --filter @phloem/protocol-types vectors:generate && node scripts/vectors/write-circom-input.mjs && node scripts/vectors/write-budget-transition-input.mjs && node scripts/vectors/write-audit-accumulator-inputs.mjs && node scripts/vectors/write-private-settlement-binding-input.mjs && node scripts/vectors/write-private-root-backing-input.mjs",
    "vectors:check": "pnpm --filter @phloem/protocol-types vectors:check",
    "phase0:check": "node scripts/preflight/phase0.mjs",
    "phase1:check": "node scripts/preflight/phase1.mjs",
    "phase1:upstreams": "scripts/preflight/pinned-upstreams.sh",
    "spp:deployment:prepare": "scripts/deploy/prepare-spp-usdc-wasm.sh",
    "spp:deployment:verify": "node scripts/deploy/verify-spp-usdc-testnet.mjs",
    "phloem:deployment:preflight": "node scripts/deploy/preflight-phloem-testnet.mjs",
    "spp:runtime:simulate": "scripts/spp/simulate-private-runtime.sh",
    "zk:setup:budget": "node scripts/zk/setup-budget-transition.mjs",
    "zk:check:local-worker": "tsx scripts/zk/check-local-proof-worker.ts"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "17.1.0",
    "@taceo/circom-lib": "0.9.0",
    "@taceo/poseidon2": "0.2.0",
    "circomlib": "2.0.5",
    "snarkjs": "0.7.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
